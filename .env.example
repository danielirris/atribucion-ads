# Credenciales de la Facebook Marketing API
# Copia este archivo como .env y rellena tus valores reales.

# --- App central de Meta (una sola, sirve para todos tus Business) ---
APP_ID=tu_app_id
APP_SECRET=tu_app_secret

# --- Contraseña de acceso a la app (MUY recomendado en dominio público) ---
# Si la dejas vacía, la app queda abierta a cualquiera con el enlace.
APP_PASSWORD=cambia_esto_por_una_clave

# --- Supabase (2ª fuente de ventas) ---
# La URL del proyecto (Project Settings → API → Project URL) y una API key
# (service_role recomendada para lectura completa; o anon si la tabla es legible).
# La tabla y el mapeo de columnas se configuran dentro de la app.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_KEY=tu_service_role_o_anon_key

# --- MODO MULTI-BUSINESS (recomendado) ---
# NO pongas tokens aquí. Agrégalos dentro de la app, en la sección "Conexiones":
# un token de Usuario del Sistema por cada Business. La app descubre sus cuentas
# automáticamente y guarda los tokens en el volumen /data (no en el repo).

# --- MODO UNA SOLA CUENTA (opcional, alternativa simple) ---
# Si solo usas una cuenta, puedes definir aquí el token y la cuenta, y saltarte
# la sección "Conexiones":
# ACCESS_TOKEN=tu_access_token_de_larga_duracion
# AD_ACCOUNT_ID=act_1234567890

# --- Opcionales (tienen valores por defecto) ---
# Nombre del archivo de base de datos SQLite (en la carpeta del proyecto)
DB_FILE=datos.db
# Nombre del archivo Excel a monitorear (en la carpeta del proyecto)
EXCEL_FILE=ventas.xlsx
# Intervalo de polling a Facebook en segundos (300 = 5 minutos)
POLLING_INTERVAL_SEG=300

# (Opcional) Tipos de acción que cuentan como "conversación iniciada" (mensajería),
# separados por coma. Si tus anuncios son de mensajes (Messenger/WhatsApp) y la
# columna Conversaciones sale en 0, ajusta esto al action_type que use tu cuenta.
# MSG_ACTION_TYPES=onsite_conversion.messaging_conversation_started_7d,onsite_conversion.total_messaging_connection
